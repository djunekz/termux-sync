#!/data/data/com.termux/files/usr/bin/bash

#  tsctl — termux-sync Control Tool
#  Manages install, uninstall, and update for termux-sync
#  https://github.com/djunekz/termux-sync
#  Open Source — MIT License

set -euo pipefail

REPO_URL="https://github.com/djunekz/termux-sync.git"
REPO_RAW="https://raw.githubusercontent.com/djunekz/termux-sync/main/termux-sync.py"
INSTALL_DIR="$PREFIX/lib/termux-sync"
SCRIPT="$INSTALL_DIR/termux-sync.py"
CMD="$PREFIX/bin/termux-sync"
CONFIG_DIR="$HOME/.config/termux-sync"
TSCTL_CMD="$PREFIX/bin/tsctl"

R='\033[0;31m'
G='\033[0;32m'
Y='\033[1;33m'
C='\033[0;36m'
D='\033[2m'
B='\033[1m'
N='\033[0m'

banner() {
cat << 'EOF'

  ████████╗███████╗ ██████╗████████╗██╗
  ╚══██╔══╝██╔════╝██╔════╝╚══██╔══╝██║
     ██║   ███████╗██║        ██║   ██║
     ██║   ╚════██║██║        ██║   ██║
     ██║   ███████║╚██████╗   ██║   ███████╗
     ╚═╝   ╚══════╝ ╚═════╝   ╚═╝   ╚══════╝

EOF
}

STEP=0
step()  {
    STEP=$((STEP + 1))
    printf "\n${C}[%d]${N} ${B}%s${N}\n" "$STEP" "$*"
}
ok()    { printf "     ${G}OK${N}   %s\n" "$*"; }
warn()  { printf "     ${Y}WARN${N} %s\n" "$*"; }
fail()  { printf "\n     ${R}FAIL${N} %s\n\n" "$*"; exit 1; }
info()  { printf "     ${D}--${N}   %s\n" "$*"; }
hr()    { printf "${D}%s${N}\n" "─────────────────────────────────────────────────────"; }

print_banner() {
    printf "${C}${B}"
    banner
    printf "${N}"
    printf "  ${B}tsctl${N}  ${D}termux-sync Control Tool${N}\n"
    printf "  ${D}https://github.com/djunekz/termux-sync${N}\n\n"
    hr
}

cmd_install() {
    print_banner

    if [[ -f "$SCRIPT" ]]; then
        warn "termux-sync is already installed at $INSTALL_DIR"
        printf "\n  Run ${C}tsctl updater${N} to update, or ${C}tsctl uninstall${N} to remove.\n\n"
        exit 0
    fi

    step "Updating package lists"
    if pkg update -y -q 2>/dev/null; then
        ok "Package lists updated"
    else
        warn "Could not update package lists (continuing)"
    fi

    step "Installing Python"
    if pkg install -y python python-pip 2>/dev/null; then
        PY_VER=$(python --version 2>&1 | awk '{print $2}')
        ok "Python $PY_VER"
    else
        fail "Failed to install Python"
    fi

    step "Installing git"
    if pkg install -y git 2>/dev/null; then
        ok "git $(git --version | awk '{print $3}')"
    else
        fail "Failed to install git"
    fi

    step "Installing Python dependencies"
    for dep in rich; do
        if pip install --quiet "$dep" 2>/dev/null; then
            ok "$dep"
        else
            fail "Failed to install $dep"
        fi
    done

    step "Cloning termux-sync"
    info "Destination: $INSTALL_DIR"
    rm -rf "$INSTALL_DIR"
    if git clone --depth=1 "$REPO_URL" "$INSTALL_DIR" 2>/dev/null; then
        ok "Cloned to $INSTALL_DIR"
    else
        fail "Failed to clone $REPO_URL"
    fi

    step "Setting permissions"
    chmod +x "$SCRIPT"
    ok "termux-sync.py is executable"

    step "Installing termux-sync command"
    rm -f "$CMD"
    printf '#!/data/data/com.termux/files/usr/bin/bash\nexec python "%s" "$@"\n' "$SCRIPT" > "$CMD"
    chmod +x "$CMD"
    ok "Launcher installed to $CMD"

    step "Cleaning shell config"
    for RC in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.profile"; do
        if [[ -f "$RC" ]] && grep -q "termux.sync\|termux_sync" "$RC" 2>/dev/null; then
            sed -i '/termux.sync\|termux_sync/d' "$RC"
            ok "Cleaned stale alias from $(basename "$RC")"
        fi
    done
    info "No alias added — use the 'termux-sync' command directly"

    printf "\n"
    hr
    printf "\n  ${G}${B}termux-sync installed successfully!${N}\n\n"
    printf "  ${D}First-time setup:${N}\n"
    printf "    ${C}termux-sync setup${N}\n\n"
    printf "  ${D}Create a backup:${N}\n"
    printf "    ${C}termux-sync backup${N}\n\n"
    printf "  ${D}Restore from backup:${N}\n"
    printf "    ${C}termux-sync restore${N}\n\n"
    hr
    printf "\n"
}

cmd_updater() {
    print_banner

    if [[ ! -d "$INSTALL_DIR" ]]; then
        fail "termux-sync is not installed. Run: tsctl install"
    fi

    step "Checking for updates"

    LOCAL_HASH=$(git -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null || echo "unknown")
    info "Local  : $LOCAL_HASH"

    git -C "$INSTALL_DIR" fetch origin --quiet 2>/dev/null || fail "Could not reach GitHub. Check your internet connection."

    REMOTE_HASH=$(git -C "$INSTALL_DIR" rev-parse origin/HEAD 2>/dev/null || \
                  git -C "$INSTALL_DIR" rev-parse origin/main 2>/dev/null || echo "unknown")
    info "Remote : $REMOTE_HASH"

    if [[ "$LOCAL_HASH" == "$REMOTE_HASH" ]]; then
        ok "Already up to date"
        printf "\n"
        hr
        printf "\n  ${G}${B}termux-sync is up to date.${N}\n\n"
        hr
        printf "\n"
        exit 0
    fi

    step "Changes in termux-sync.py"
    CHANGED_FILES=$(git -C "$INSTALL_DIR" diff --name-only HEAD origin/HEAD 2>/dev/null || true)
    if echo "$CHANGED_FILES" | grep -q "termux-sync.py"; then
        ok "termux-sync.py has been updated"
    else
        info "No changes in termux-sync.py"
        warn "Other files changed — updating anyway"
    fi

    step "Pulling updates"
    if git -C "$INSTALL_DIR" pull origin --quiet 2>/dev/null; then
        NEW_HASH=$(git -C "$INSTALL_DIR" rev-parse HEAD 2>/dev/null)
        ok "Updated to $NEW_HASH"
    else
        fail "Failed to pull updates"
    fi

    step "Re-setting permissions"
    chmod +x "$SCRIPT"
    ok "termux-sync.py is executable"

    step "Refreshing launcher"
    rm -f "$CMD"
    printf '#!/data/data/com.termux/files/usr/bin/bash\nexec python "%s" "$@"\n' "$SCRIPT" > "$CMD"
    chmod +x "$CMD"
    ok "Launcher refreshed at $CMD"

    printf "\n"
    hr
    printf "\n  ${G}${B}termux-sync updated successfully!${N}\n\n"
    hr
    printf "\n"
}

cmd_uninstall() {
    print_banner

    printf "  ${Y}${B}This will remove termux-sync from your system.${N}\n\n"
    printf "  The following will be deleted:\n"
    printf "    ${D}·${N} Launcher    : $CMD\n"
    printf "    ${D}·${N} Install dir : $INSTALL_DIR\n"
    printf "    ${D}·${N} Config      : $CONFIG_DIR\n"
    printf "    ${D}·${N} Shell aliases in .bashrc / .zshrc\n\n"
    printf "  ${B}Continue? [y/N]${N} "
    read -r CONFIRM
    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
        printf "\n  Aborted.\n\n"
        exit 0
    fi

    printf "\n"

    step "Removing launcher"
    if [[ -f "$CMD" ]]; then
        rm -f "$CMD"
        ok "Removed $CMD"
    else
        info "Launcher not found, skipping"
    fi

    step "Removing install directory"
    if [[ -d "$INSTALL_DIR" ]]; then
        rm -rf "$INSTALL_DIR"
        ok "Removed $INSTALL_DIR"
    else
        info "Install directory not found, skipping"
    fi

    step "Removing config"
    if [[ -d "$CONFIG_DIR" ]]; then
        rm -rf "$CONFIG_DIR"
        ok "Removed $CONFIG_DIR"
    else
        info "Config directory not found, skipping"
    fi

    step "Cleaning shell aliases"
    for RC in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.profile"; do
        if [[ -f "$RC" ]] && grep -q "termux.sync\|termux_sync" "$RC" 2>/dev/null; then
            sed -i '/termux.sync\|termux_sync/d' "$RC"
            ok "Cleaned $(basename "$RC")"
        fi
    done

    step "Removing alias from current session"
    unalias termux-sync 2>/dev/null && ok "Unaliased termux-sync" || info "No active alias found"

    printf "\n"
    hr
    printf "\n  ${G}${B}termux-sync uninstalled successfully.${N}\n\n"
    printf "  To reinstall: ${C}tsctl install${N}\n\n"
    hr
    printf "\n"
}

cmd_status() {
    print_banner
    printf "  ${B}Installation Status${N}\n\n"

    if [[ -f "$SCRIPT" ]]; then
        printf "  ${G}●${N} termux-sync.py   ${D}$SCRIPT${N}\n"
        HASH=$(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
        printf "  ${G}●${N} version          ${D}$HASH${N}\n"
    else
        printf "  ${R}●${N} termux-sync      ${D}not installed${N}\n"
    fi

    if [[ -f "$CMD" ]]; then
        printf "  ${G}●${N} launcher         ${D}$CMD${N}\n"
    else
        printf "  ${R}●${N} launcher         ${D}not found${N}\n"
    fi

    if [[ -d "$CONFIG_DIR" ]]; then
        printf "  ${G}●${N} config           ${D}$CONFIG_DIR${N}\n"
    else
        printf "  ${Y}●${N} config           ${D}not found${N}\n"
    fi

    printf "\n"
    hr
    printf "\n"
}

cmd_help() {
    print_banner
    printf "  ${B}Usage:${N} tsctl <command>\n\n"
    printf "  ${C}install${N}    Install termux-sync\n"
    printf "  ${C}uninstall${N}  Remove termux-sync\n"
    printf "  ${C}updater${N}    Update termux-sync to the latest version\n"
    printf "  ${C}status${N}     Show installation status\n"
    printf "  ${C}help${N}       Show this help message\n\n"
    hr
    printf "\n"
}

case "${1:-help}" in
    install)   cmd_install   ;;
    uninstall) cmd_uninstall ;;
    updater)   cmd_updater   ;;
    status)    cmd_status    ;;
    help|--help|-h) cmd_help ;;
    *)
        printf "\n  ${R}Unknown command:${N} $1\n"
        printf "  Run ${C}tsctl help${N} for usage.\n\n"
        exit 1
        ;;
esac
